#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <150>;
            retro-tap;
        };

        ae: ae {
            compatible = "zmk,behavior-mod-morph";
            label = "AE";
            bindings = <&small_ae>, <&capital_ae>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        oe: oe {
            compatible = "zmk,behavior-mod-morph";
            label = "OE";
            bindings = <&small_oe>, <&capital_oe>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ao: ao {
            compatible = "zmk,behavior-mod-morph";
            label = "AO";
            bindings = <&kp LA(A)>, <&kp LS(LA(A))>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lp_ae: lp_ae {
            compatible = "zmk,behavior-hold-tap";
            label = "LP_AE";
            bindings = <&ae>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        lp_oe: lp_oe {
            compatible = "zmk,behavior-hold-tap";
            label = "LP_OE";
            bindings = <&oe>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        lp_ao: lp_ao {
            compatible = "zmk,behavior-hold-tap";
            label = "LP_AO";
            bindings = <&ao>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };

        gui_left_querty: gui_left_querty {
            compatible = "zmk,behavior-mod-morph";
            label = "GUI_LEFT_QUERTY";
            bindings = <&kp H>, <&kp LEFT_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        gui_down_qwerty: gui_down_qwerty {
            compatible = "zmk,behavior-mod-morph";
            label = "GUI_DOWN_QWERTY";
            bindings = <&hm RIGHT_SHIFT J>, <&kp DOWN_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        gui_up_qwerty: gui_up_qwerty {
            compatible = "zmk,behavior-mod-morph";
            label = "GUI_UP_QWERTY";
            bindings = <&hm RIGHT_GUI K>, <&kp UP_ARROW>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        gui_right_querty: gui_right_querty {
            compatible = "zmk,behavior-mod-morph";
            label = "GUI_RIGHT_QUERTY";
            bindings = <&hm RIGHT_ALT L>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        leftpar_less: leftpar_less {
            compatible = "zmk,behavior-mod-morph";
            label = "LEFTPAR_LESS";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        rightpar_more: rightpar_more {
            compatible = "zmk,behavior-mod-morph";
            label = "RIGHTPAR_MORE";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&lt 1 TAB>;
            key-positions = <13 12>;
        };

        backsp {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;
        };

        dash {
            bindings = <&lt 2 MINUS>;
            key-positions = <12 11>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <22 23>;
        };

        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <17 18>;
        };

        single_quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 29>;
        };

        left_mouse_click {
            bindings = <&mkp RCLK>;
            key-positions = <13 33>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <13 16>;
        };

        bt_clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 2>;
        };

        excl_mark {
            bindings = <&kp EXCL>;
            key-positions = <6 7>;
            timeout-ms = <30>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 20>;
        };

        email {
            bindings = <&emailaddress>;
            key-positions = <18 19 17>;
        };

        enter2 {
            bindings = <&kp ENTER>;
            key-positions = <27 26>;
        };

        emailprivate {
            bindings = <&emailaddressprivate>;
            key-positions = <28 29 30>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <25 26>;
        };
    };

    macros {
        small_ae: small_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp A>;
            label = "SMALL_AE";
            wait-ms = <0>;
        };

        capital_ae: capital_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp LS(A)>;
            label = "CAPITAL_AE";
            wait-ms = <0>;
        };

        small_oe: small_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp O>;
            label = "SMALL_OE";
        };

        capital_oe: capital_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(U) &kp LS(O)>;
            label = "CAPITAL_OE";
            wait-ms = <0>;
        };

        emailaddress: emailaddress {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp N &kp D &kp R &kp E &kp A &kp S &kp DOT &kp H &kp A &kp L &kp L &kp B &kp E &kp R &kp G &kp AT &kp S &kp P &kp R &kp A &kp K &kp DOT &kp G &kp U &kp DOT &kp S &kp E>;
            label = "EMAILADDRESS";
            wait-ms = <0>;
        };

        emailaddressprivate: emailaddressprivate {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp A &kp N &kp D &kp R &kp E &kp A &kp S &kp M &kp A &kp R &kp T &kp E &kp N &kp H &kp A &kp L &kp L &kp B &kp E &kp R &kp G &kp AT &kp G &kp M &kp A &kp I &kp L &kp DOT &kp C &kp O &kp M>;
            label = "EMAILADDRESSPRIVATE";
            wait-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            label = "BASE";
            bindings = <
                &kp Q        &kp W           &lp_ae 0 E      &kp R             &kp T           &kp Y             &lp_ao 0 U        &kp I           &lp_oe 0 O         &ht COLON SEMI
                &hm LCTRL A  &hm LEFT_ALT S  &hm LEFT_GUI D  &hm LEFT_SHIFT F  &kp G           &gui_left_querty  &gui_down_qwerty  &gui_up_qwerty  &gui_right_querty  &hm RCTRL P
&sk LEFT_SHIFT  &ht LG(Z) Z  &ht LG(X) X     &ht LG(C) C     &ht LG(V) V       &kp B           &kp N             &kp M             &kp COMMA       &kp DOT            &kp FSLH        &sk RIGHT_SHIFT
                                             &mkp RCLK       &mkp LCLK         &lt 2 ESCAPE    &lt 3 SPACE       &sk RIGHT_SHIFT   &caps_word
            >;
        };

        num_layer {
            bindings = <
       &trans  &trans  &trans  &trans      &trans    &kp ASTRK     &kp N7        &kp N8        &kp N9        &kp PLUS
       &trans  &trans  &trans  &caps_word  &trans    &kp EQUAL     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&none  &trans  &trans  &trans  &trans      &trans    &kp PERIOD    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &none
                       &none   &trans      &trans    &kp NUMBER_0  &trans        &none
            >;
        };

        sym_layer {
            bindings = <
       &trans  &trans  &trans  &kp C_VOLUME_UP    &kp C_BRI_UP     &kp PIPE       &kp AMPS    &kp ASTRK    &kp GRAVE  &trans
       &trans  &trans  &trans  &kp K_VOLUME_DOWN  &kp C_BRI_DEC    &kp BACKSLASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &trans
&none  &trans  &trans  &trans  &trans             &trans           &kp TILDE      &kp EXCL    &kp AT       &kp HASH   &trans  &none
                       &none   &trans             &trans           &trans         &trans      &none
            >;
        };

        del_layer {
            bindings = <
       &trans  &trans  &trans  &kp C_VOLUME_UP  &kp C_BRI_UP     &kp C_VOLUME_UP  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans     &trans
       &trans  &trans  &trans  &kp C_VOL_DN     &kp C_BRI_DEC    &kp C_VOL_DN     &leftpar_less     &rightpar_more     &kp GRAVE  &trans
&none  &trans  &trans  &trans  &trans           &trans           &trans           &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans     &trans  &none
                       &none   &trans           &trans           &trans           &trans            &none
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
